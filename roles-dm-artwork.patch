     return (it != j.end() && it->is_string()) ? it->get<std::string>() : fallback;
 }
+bool boolOr(const json& j, const char* key, bool fallback = false) {
+    auto it = j.find(key);
+    return (it != j.end() && it->is_boolean()) ? it->get<bool>() : fallback;
+}
