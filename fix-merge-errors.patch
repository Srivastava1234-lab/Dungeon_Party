From f6ca464aeb5a3f1383c4c4b52036710bdc67f7b6 Mon Sep 17 00:00:00 2001
From: Akshat <akshat@local>
Date: Mon, 9 Nov 2026 17:58:58 +0000
Subject: [PATCH] Fix build errors after Sprint 2 merges

- HeroCard: keep both Kagan's class/support fields and Hulya's spell target + freeze
  (the merge kept only one header, but code from both branches uses it)
- Player::playCard: shield code used the old single 'target' parameter; use targets list
- main.cpp: close roleName()'s switch/function (missing braces)
- main.cpp: remove role-picker fragment that ended up in the menu screen; restore the
  SCRUM-35 role picker in the networked lobby (local only until the server knows roles)
- CMake: game_logic links nlohmann_json (GameState.cpp needs it)
---
 CMakeLists.txt     |  1 +
 include/HeroCard.h |  7 +++++++
 main.cpp           | 39 ++++++++++++++++++++++++++-------------
 src/Card.cpp       |  6 ++++++
 src/Player.cpp     |  3 ++-
 5 files changed, 42 insertions(+), 14 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index b479334..8c1f38b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -97,6 +97,7 @@ add_library(game_logic STATIC
         src/Trap.cpp
 )
 target_include_directories(game_logic PUBLIC include)
+target_link_libraries(game_logic PUBLIC nlohmann_json::nlohmann_json)
 
 # Client-side networking
 add_library(net_client STATIC net/NetClient.cpp)
diff --git a/include/HeroCard.h b/include/HeroCard.h
index 052a7af..dcea734 100644
--- a/include/HeroCard.h
+++ b/include/HeroCard.h
@@ -9,8 +9,15 @@ class HeroCard : public Card {
     int value;
     std::optional<HeroClass> requiredClass;
     SupportTarget supportTarget;
+    SpellTarget target = SpellTarget::ONE_ENEMY; // spells (Hülya, Sprint 2)
+    int freezeRounds = 0;
 public:
+    // Class-restricted / support cards (Kagan)
     HeroCard(std::string name, int cost, HeroEffect effect, int value, std::optional<HeroClass> requiredClass = std::nullopt, SupportTarget supportTarget = SupportTarget::SELF_ONLY);
+    // Spells with a target rule and optional freeze (Hülya)
+    HeroCard(std::string name, int cost, HeroEffect effect, int value, SpellTarget target, int freezeRounds = 0);
+    SpellTarget getTarget() const { return target; }
+    int getFreezeRounds() const { return freezeRounds; }
     HeroEffect getEffect() const;
     int getValue() const;
     bool canBePlayedBy(const Player& player) const override;
